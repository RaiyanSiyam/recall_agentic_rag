# ==============================================================================
# Agentic RAG over Live Data and Memory - Environment Configuration
# ==============================================================================

# Data Mode: 'demo' uses realistic seeded offline data; 'live' uses real cloud APIs.
DATA_MODE=demo

# LLM Provider: 'gemini' (default), 'openai', 'anthropic', or 'mock' (offline deterministic engine)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Model Names (optional overrides)
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Memory & Persistence
SQLITE_DB_PATH=./data/memory.db
CHROMA_PERSIST_DIR=./data/chroma_db

# MCP Server Execution Mode (default: stdio for embedded/container execution)
MCP_TRANSPORT=stdio

# Live Mode Credentials (Required ONLY if DATA_MODE=live)
# Gmail API (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Notion API (Integration Token)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Jira Cloud REST API
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_USER_EMAIL=user@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ

# Server Networking
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173
VITE_API_URL=http://localhost:8000
